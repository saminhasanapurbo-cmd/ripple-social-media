rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /view_once_uploads/{conversationId}/{userId}/{uploadId} {
      allow read: if false; // No direct read
      allow create: if request.auth != null && request.auth.uid == userId 
                    && (request.resource.contentType == 'image/jpeg' || request.resource.contentType == 'image/png' || request.resource.contentType == 'image/webp' || request.resource.contentType == 'image/gif')
                    && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId; // allow cleanup
    }
    match /view_once_media/{conversationId}/{messageId} {
      allow read, write, delete: if false; // Only Admin SDK
    }
    match /{allPaths=**} {
      allow read: if request.auth != null 
                  && !allPaths.matches('^view_once_uploads/.*')
                  && !allPaths.matches('^view_once_media/.*');
      allow write: if request.auth != null 
                   && !allPaths.matches('^view_once_uploads/.*')
                   && !allPaths.matches('^view_once_media/.*')
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType == 'image/jpeg' || request.resource.contentType == 'image/png' || request.resource.contentType == 'image/webp' || request.resource.contentType == 'image/gif');
    }
  }
}
